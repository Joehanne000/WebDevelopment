* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}
body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background-color: #f4f4f8;
}
.navbar {
    background-color: #1c1c24;
    color: white;
    padding: 15px;
    text-align: center;
    display: flex;
    justify-content: center;
    gap: 20px;
   
}

.navbar a {
    color: white;
    text-decoration: none;
    font-size: 18px;
    padding: 20px;
    margin: 5px;

}
.container {
    display: flex;
    flex: 5px;
    padding: 20px;
}
.sidebar {
    width: 200px;
    background-color: #1c1c24;
    color: white;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin: 15px;
    border-radius: 20px;
}
.sidebar button {
    background-color: #333;
    color: white;
    border: none;
    padding: 20px;
    text-align: center;
    cursor: pointer;
    width: 100%;

}
.sidebar button:hover {
    background-color: #ff6b6b;
    text-decoration-color: #222;
}
.content {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 10px;
    padding: 20px;
    height: 100%;
    width: 50%;
    border-spacing: 20px;
    
}
.card {
    background-color: white;
    padding:30px;
    box-shadow: 0px 4px 6px rgba(0,0,0,0.1);
    border-radius: 10px;
}
.card img {
    width: 100%;
    height: 200px;
    border-radius: 5px;
    object-fit: cover;
}
.card h3 {
    margin: 10px 0 5px;
}
footer {
    background-color: #1c1c24;
    color: white;
    text-align: center;
    padding: 10px;
}
